page {
    background-color: #f5f5f5;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    font-size: 28rpx;
    color: #333;
}

.container {
    min-height: 100vh;
    padding: 20rpx;
    box-sizing: border-box;
}

.btn-primary {
    background-color: #4A90E2;
    color: #fff;
    border-radius: 8rpx;
    padding: 24rpx;
    text-align: center;
    font-size: 32rpx;
    font-weight: 500;
}

.btn-primary:active {
    background-color: #357ABD;
}

.btn-disabled {
    background-color: #ccc;
    color: #999;
}

.card {
    background-color: #fff;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.text-primary {
    color: #4A90E2;
}

.text-danger {
    color: #E74C3C;
}

.text-success {
    color: #27AE60;
}

.text-warning {
    color: #F39C12;
}

.text-muted {
    color: #999;
    font-size: 24rpx;
}

.text-center {
    text-align: center;
}

.mt-20 {
    margin-top: 20rpx;
}

.mb-20 {
    margin-bottom: 20rpx;
}

.loading {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40rpx;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 40rpx;
    color: #999;
}

.empty-state image {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 20rpx;
}
