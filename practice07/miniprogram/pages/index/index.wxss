.container {
    padding: 0;
    background-color: #f5f5f5;
}

.banner {
    width: 100%;
    height: 320rpx;
}

.banner image {
    width: 100%;
    height: 100%;
}

.check-section {
    padding: 40rpx 30rpx;
    background-color: #fff;
    margin-bottom: 20rpx;
}

.check-btn {
    width: 100%;
    height: 240rpx;
    background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
    border-radius: 16rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 36rpx;
    font-weight: 500;
    box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.3);
}

.check-btn .iconfont {
    font-size: 48rpx;
    margin-bottom: 12rpx;
}

.check-btn .subtitle {
    font-size: 24rpx;
    opacity: 0.9;
    margin-top: 8rpx;
}

.section {
    background-color: #fff;
    padding: 30rpx;
    margin-bottom: 20rpx;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24rpx;
}

.section-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
}

.section-more {
    font-size: 24rpx;
    color: #999;
}

.article-list {
    display: flex;
    flex-direction: column;
}

.article-card {
    display: flex;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
}

.article-card:last-child {
    border-bottom: none;
}

.article-cover {
    width: 160rpx;
    height: 120rpx;
    border-radius: 8rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.article-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.article-title {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.article-summary {
    font-size: 24rpx;
    color: #999;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.article-views {
    font-size: 22rpx;
    color: #ccc;
}
