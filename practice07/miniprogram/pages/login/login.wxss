.container {
    min-height: 100vh;
    background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0;
}

.login-header {
    margin-top: 200rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 120rpx;
}

.logo {
    width: 160rpx;
    height: 160rpx;
    margin-bottom: 32rpx;
}

.title {
    font-size: 48rpx;
    font-weight: 600;
    color: #fff;
    margin-bottom: 16rpx;
}

.subtitle {
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.9);
}

.login-content {
    width: 100%;
    padding: 60rpx 60rpx;
    background-color: #fff;
    border-radius: 32rpx 32rpx 0 0;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
}

.desc {
    display: block;
    text-align: center;
    font-size: 28rpx;
    color: #666;
    margin-bottom: 48rpx;
}

.login-btn {
    width: 100%;
    height: 88rpx;
    background-color: #07C160;
    color: #fff;
    border-radius: 44rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    font-weight: 500;
    margin-bottom: 32rpx;
}

.login-btn .iconfont {
    margin-right: 16rpx;
    font-size: 36rpx;
}

.login-btn:active {
    background-color: #06AD56;
}

.privacy-tips {
    text-align: center;
    font-size: 24rpx;
    color: #999;
}

.privacy-tips .link {
    color: #4A90E2;
}
