.container {
    min-height: 100vh;
    background-color: #f5f5f5;
    padding: 0;
}

.disclaimer-section {
    min-height: 100vh;
    background-color: #fff;
    padding: 30rpx;
    display: flex;
    flex-direction: column;
}

.disclaimer-header {
    display: flex;
    align-items: center;
    margin-bottom: 24rpx;
}

.disclaimer-icon {
    font-size: 40rpx;
    margin-right: 16rpx;
}

.disclaimer-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #E74C3C;
}

.disclaimer-content {
    flex: 1;
    max-height: 600rpx;
    padding: 24rpx;
    background-color: #FFF5F5;
    border: 2rpx solid #FFE0E0;
    border-radius: 12rpx;
    font-size: 26rpx;
    line-height: 1.8;
    color: #666;
    margin-bottom: 24rpx;
}

.confirm-btn {
    width: 100%;
    height: 88rpx;
    background-color: #4A90E2;
    color: #fff;
    border-radius: 44rpx;
    font-size: 32rpx;
    font-weight: 500;
}

.confirm-btn.disabled {
    background-color: #ccc;
}

.result-section {
    padding: 20rpx;
}

.result-card {
    background-color: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
}

.result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24rpx;
}

.result-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
}

.urgency-badge {
    padding: 8rpx 20rpx;
    border-radius: 24rpx;
    font-size: 24rpx;
    font-weight: 500;
}

.urgency-low {
    background-color: #E8F5E9;
    color: #27AE60;
}

.urgency-medium {
    background-color: #FFF9E6;
    color: #F39C12;
}

.urgency-high {
    background-color: #FFEBEE;
    color: #E74C3C;
}

.primary-result {
    margin-bottom: 24rpx;
}

.disease-name {
    display: block;
    font-size: 40rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 16rpx;
}

.confidence-bar {
    height: 16rpx;
    background-color: #f0f0f0;
    border-radius: 8rpx;
    overflow: hidden;
    margin-bottom: 12rpx;
}

.confidence-fill {
    height: 100%;
    background: linear-gradient(90deg, #4A90E2 0%, #27AE60 100%);
    border-radius: 8rpx;
    transition: width 0.3s ease;
}

.confidence-text {
    font-size: 26rpx;
    color: #666;
}

.alternatives {
    padding: 20rpx;
    background-color: #f9f9f9;
    border-radius: 12rpx;
    margin-bottom: 24rpx;
}

.alternatives-title {
    display: block;
    font-size: 26rpx;
    color: #666;
    margin-bottom: 12rpx;
}

.alternative-item {
    display: flex;
    justify-content: space-between;
    padding: 12rpx 0;
    font-size: 28rpx;
}

.alternative-confidence {
    color: #999;
}

.unknown-result {
    text-align: center;
    padding: 40rpx 0;
}

.unknown-text {
    display: block;
    font-size: 36rpx;
    font-weight: 600;
    color: #E74C3C;
    margin-bottom: 16rpx;
}

.unknown-tips {
    font-size: 28rpx;
    color: #666;
}

.description {
    padding: 20rpx;
    background-color: #f9f9f9;
    border-radius: 12rpx;
    margin-bottom: 24rpx;
}

.description-title {
    display: block;
    font-size: 26rpx;
    color: #666;
    margin-bottom: 12rpx;
}

.description-text {
    font-size: 28rpx;
    color: #333;
    line-height: 1.6;
}

.suggestions {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.suggestion-item {
    display: flex;
    align-items: center;
    font-size: 28rpx;
}

.suggestion-icon {
    margin-right: 12rpx;
}

.suggestion-label {
    color: #666;
}

.suggestion-value {
    color: #333;
    font-weight: 500;
}

.related-articles {
    background-color: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
}

.section-title {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 24rpx;
}

.article-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.article-item {
    display: flex;
    align-items: center;
}

.article-item image {
    width: 120rpx;
    height: 90rpx;
    border-radius: 8rpx;
    margin-right: 20rpx;
}

.article-title {
    flex: 1;
    font-size: 28rpx;
    color: #333;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.footer-actions {
    display: flex;
    gap: 20rpx;
    padding: 20rpx 0;
}

.action-btn {
    flex: 1;
    height: 88rpx;
    border-radius: 44rpx;
    font-size: 32rpx;
    font-weight: 500;
}

.action-btn.secondary {
    background-color: #fff;
    color: #4A90E2;
    border: 2rpx solid #4A90E2;
}

.action-btn.primary {
    background-color: #4A90E2;
    color: #fff;
}
