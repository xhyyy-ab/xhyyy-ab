.container {
    padding: 0;
    background-color: #f5f5f5;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.guide {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.guide-content {
    width: 600rpx;
    background-color: #fff;
    border-radius: 16rpx;
    padding: 40rpx;
}

.guide-title {
    display: block;
    font-size: 36rpx;
    font-weight: 600;
    text-align: center;
    margin-bottom: 32rpx;
}

.guide-list {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
    margin-bottom: 32rpx;
}

.guide-list text {
    font-size: 28rpx;
    color: #666;
}

.guide-btn {
    width: 100%;
    height: 80rpx;
    background-color: #4A90E2;
    color: #fff;
    border-radius: 40rpx;
    font-size: 32rpx;
}

.upload-section {
    background-color: #fff;
    padding: 30rpx;
    margin-bottom: 20rpx;
}

.image-list {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
}

.image-item {
    position: relative;
    width: 200rpx;
    height: 200rpx;
}

.image-item image {
    width: 100%;
    height: 100%;
    border-radius: 12rpx;
}

.delete-btn {
    position: absolute;
    top: -16rpx;
    right: -16rpx;
    width: 48rpx;
    height: 48rpx;
    background-color: #E74C3C;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
}

.add-image {
    width: 200rpx;
    height: 200rpx;
    border: 2rpx dashed #ccc;
    border-radius: 12rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #fafafa;
}

.add-icon {
    font-size: 64rpx;
    color: #ccc;
    margin-bottom: 8rpx;
}

.add-text {
    font-size: 24rpx;
    color: #999;
}

.add-count {
    font-size: 22rpx;
    color: #ccc;
    margin-top: 8rpx;
}

.body-part-section {
    background-color: #fff;
    padding: 30rpx;
    margin-bottom: 20rpx;
}

.section-title {
    display: block;
    font-size: 28rpx;
    color: #666;
    margin-bottom: 20rpx;
}

.body-part-list {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.body-part-item {
    padding: 16rpx 32rpx;
    background-color: #f5f5f5;
    border-radius: 32rpx;
    font-size: 26rpx;
    color: #666;
}

.body-part-item.active {
    background-color: #4A90E2;
    color: #fff;
}

.tips {
    background-color: #FFF9E6;
    padding: 24rpx 30rpx;
    margin: 20rpx 0;
}

.tips-title {
    display: block;
    font-size: 26rpx;
    color: #F39C12;
    margin-bottom: 8rpx;
}

.tips-text {
    font-size: 24rpx;
    color: #999;
    line-height: 1.6;
}

.footer {
    margin-top: auto;
    padding: 30rpx;
    background-color: #fff;
}

.analyze-btn {
    width: 100%;
    height: 88rpx;
    background-color: #4A90E2;
    color: #fff;
    border-radius: 44rpx;
    font-size: 32rpx;
    font-weight: 500;
}

.analyze-btn.disabled {
    background-color: #ccc;
}
